# Copy to .env for local development. Never commit the real .env.
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql://wii@localhost/eggcvdatabase
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

MODEL_PATH=egg_detection/finetune_egg_v1/weights/best.pt
DAMAGE_MODEL_PATH=models/egg_grader_crop_resnet18_v1.pth
CONFIDENCE_THRESHOLD=0.75
DAMAGE_DECISION_THRESHOLD=0.18
DAMAGE_REVIEW_THRESHOLD=0.75
CLEANLINESS_DECISION_THRESHOLD=0.04
CLEANLINESS_REVIEW_THRESHOLD=0.75
MAX_TRAY_EGGS=5
DETECTION_DUPLICATE_IOU=0.85
DETECTION_CROP_PADDING=0.1
MIN_CROP_SIZE=8

MM_PER_PIXEL=0.09
WEIGHT_K=0.0
CALIBRATION_VERSION=uncalibrated
