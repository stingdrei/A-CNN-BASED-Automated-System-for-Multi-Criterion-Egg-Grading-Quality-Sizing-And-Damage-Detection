# Canonical example lives at the repository root: ../.env.example
# This copy is kept for backend-only deployment tooling.
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql://wii@localhost/eggcvdatabase
SECRET_KEY=your-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
DAMAGE_DECISION_THRESHOLD=0.18
DAMAGE_REVIEW_THRESHOLD=0.75
MAX_TRAY_EGGS=5
DETECTION_DUPLICATE_IOU=0.85
DETECTION_CROP_PADDING=0.1
MIN_CROP_SIZE=8
MM_PER_PIXEL=0.09
WEIGHT_K=0.0
CALIBRATION_VERSION=uncalibrated
